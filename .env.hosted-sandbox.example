# PUBLIC EXAMPLE ONLY. No real credentials; not a deployment or approval.
# Keep a filled copy outside Git; use the approved sandbox secret manager.
# Reserved SUPABASE_URL / SUPABASE_PUBLISHABLE_KEYS / SUPABASE_ANON_KEY
# are supplied by Supabase runtime. Do not set SUPABASE_* as custom secrets.
SOCIAL_ADAPTER_MODE=mock
SOCIAL_ALLOWED_ORIGINS_JSON=["http://localhost:4173"]
FACEBOOK_BOT_ALLOWED_ORIGINS_JSON=[]
FACEBOOK_BOT_PAGE_REGISTRY_JSON=[]
FACEBOOK_BOT_ERP_TOKEN_SANDBOX_A=
# After read-only review, replace registry/allowlist with the exact sandbox v1
# binding and set mode=live. Dedicated connector scope: inbox:read only.
# No settings:write / replies:* / conversations:write in the first stage.
# Organization feature flags default false; not environment variables.
# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEYS / Meta credentials are not
# required by this user-scoped gateway and must never reach the frontend.
